{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlantech-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlantech-tracker",
      // Paste the id printed by: npx wrangler d1 create atlantech-tracker
      "database_id": "49bd18ff-7aed-4038-b5ec-037eb706aede"
    }
  ]
}
